// Prisma schema for Task Management
// Datasource: PostgreSQL (swap `provider` to "mongodb" if you prefer Mongo —
// see notes at the bottom of this file for the diffs you'd need).
//
// Auth model layout follows the @auth/prisma-adapter conventions for
// NextAuth.js v5, plus a `passwordHash` and `role` on User for the
// Credentials provider and admin gating.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) — used at runtime by the app.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — Prisma uses this for migrations and
  // introspection (`db push`, `migrate dev/deploy`). Required on Neon
  // because PgBouncer's transaction-mode pooling breaks prepared statements.
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

enum TaskStatus {
  PENDING                  // assigned, not started
  IN_PROGRESS              // user is working on it
  SUBMITTED                // user uploaded proof; awaiting admin review
  COMPLETED                // admin approved the proof
  REJECTED                 // admin rejected the proof; user must resubmit
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

// ─── Auth.js / NextAuth v5 models ───────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Credentials login: bcrypt hash. Null for users who only ever use Google.
  passwordHash  String?

  role          Role      @default(USER)

  // Family-app visual identity. Each member picks an emoji + a color,
  // shown as a "chip" on task cards, headers, and comments.
  avatarColor   String?   // hex, e.g. "#f97316"
  avatarEmoji   String?   // single emoji character

  // Running total of points earned from completed tasks. Awarded by
  // approveProofAction; future rewards system will let users spend these.
  points        Int       @default(0)

  // Optional quiet hours (HH:mm in user's local timezone). When the
  // current local time is in this window, notifyUser silently skips push.
  quietHoursStart String? // "22:00"
  quietHoursEnd   String? // "07:00"

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  assignedTasks       Task[]             @relation("AssignedTasks")
  createdTasks        Task[]             @relation("CreatedTasks")
  reviewedTasks       Task[]             @relation("ReviewedTasks")
  completedSubtasks   Subtask[]          @relation("CompletedSubtasks")
  createdTemplates    TaskTemplate[]     @relation("CreatedTemplates")
  defaultedTemplates  TaskTemplate[]     @relation("TemplateDefaultAssignee")
  pushSubscriptions   PushSubscription[]
  taskComments        TaskComment[]
  activities          TaskActivity[]     @relation("ActorActivities")

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain models ──────────────────────────────────────────────────────────

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime     // stores both date and time (timestamp)
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)

  assignedToId String
  assignedTo   User   @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)

  createdById  String
  createdBy    User   @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Restrict)

  // Proof-of-completion review flow
  proofSubmittedAt DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  reviewedBy       User?     @relation("ReviewedTasks", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote       String?   // admin's note on approval/rejection

  // Optional AI verdict on the submitted proof, generated when the user
  // hits "Submit". Just a hint for the admin — doesn't auto-decide.
  aiVerdict        String?   // "match" | "mismatch" | "uncertain"
  aiConfidence     Int?      // 0-100
  aiReasoning      String?

  // Points awarded to the assignee on approval. Admin can override per
  // task in the create dialog; default is 10.
  pointsValue      Int       @default(10)
  // Optional free-text category for filtering (e.g. "chores", "homework").
  category         String?

  comments         TaskComment[]
  activities       TaskActivity[]

  // One task → many proof photos (multi-photo submissions). On resubmit
  // the old TaskProofImage rows are deleted, so the set always reflects
  // the current `proofSubmittedAt`.
  proofImages      TaskProofImage[]

  // One task → many subtasks (checklist items the assignee ticks off).
  subtasks         Subtask[]

  // Optional link to the template that created this task. Lets the admin
  // see previous instances side-by-side during review (photo comparison).
  fromTemplateId   String?
  fromTemplate     TaskTemplate? @relation("FromTemplate", fields: [fromTemplateId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([assignedToId])
  @@index([createdById])
  @@index([reviewedById])
  @@index([status])
  @@index([dueDate])
  @@index([fromTemplateId])
}

model TaskTemplate {
  id          String       @id @default(cuid())
  // Display name in the admin's template list.
  name        String
  // Becomes the spawned Task's `title`.
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  // Newline-separated checklist items, stored as a JSON string array.
  // (Postgres JSON column would be cleaner but this keeps the UI simple.)
  subtasks    String?

  defaultAssigneeId String?
  defaultAssignee   User?   @relation("TemplateDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)

  // Recurrence: null = manual (admin clicks "Create from template" when needed).
  // intervalDays: spawn a new task every N days. 1=daily, 7=weekly, 30=~monthly.
  intervalDays Int?
  // Local hour the recurring spawn should target (0-23). Used to set dueDate
  // when spawning. Null defaults to 17 (5pm).
  dueHourLocal Int?
  // Bookkeeping for the cron job: when the spawner last ran for this template.
  lastSpawnedAt DateTime?
  active       Boolean    @default(true)

  createdById String
  createdBy   User       @relation("CreatedTemplates", fields: [createdById], references: [id], onDelete: Cascade)

  spawnedTasks Task[]    @relation("FromTemplate")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
  @@index([defaultAssigneeId])
  @@index([intervalDays, active])
}

model TaskProofImage {
  id             String   @id @default(cuid())
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url            String
  // Geolocation captured on the device when the file was selected.
  // Optional because the user may decline the permission prompt.
  latitude       Float?
  longitude      Float?
  accuracyMeters Int?
  // Browser-side timestamp at the moment of capture (separate from
  // uploadedAt, which is the server-side row creation time).
  capturedAt     DateTime?
  uploadedAt     DateTime @default(now())

  @@index([taskId])
}

// One row per browser/device push subscription. A user can have many
// (e.g. installed on iPhone + Android phone + desktop Chrome).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Endpoint URL from the browser's push service. Unique per device.
  endpoint  String   @unique
  // ECDH key from the subscription, base64-url-encoded.
  p256dh    String
  // Auth secret from the subscription, base64-url-encoded.
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Audit log: timestamped record of every state-changing event on a task.
// Driven by recordActivity() from server actions. Visible to admins in
// the review dialog and on the (future) activity feed.
model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("ActorActivities", fields: [actorId], references: [id], onDelete: SetNull)
  // Free-text "kind" — e.g. "created" / "approved" / "rejected" / "duplicated"
  // / "reassigned" / "deleted" / "submitted" / "edited" / "comment".
  kind      String
  // Short human-readable description, e.g. "approved with +10 pts".
  detail    String?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([actorId])
}

// Threaded comments on a task. Either the assignee or any admin can
// post; everyone with access to the task sees the thread.
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([userId])
}

model Subtask {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean   @default(false)
  doneAt    DateTime?
  doneById  String?
  doneBy    User?     @relation("CompletedSubtasks", fields: [doneById], references: [id], onDelete: SetNull)
  position  Int       @default(0)  // for ordering
  createdAt DateTime  @default(now())

  @@index([taskId])
  @@index([doneById])
}

// ─── MongoDB note ───────────────────────────────────────────────────────────
// If you'd rather use MongoDB, change the datasource to:
//   provider = "mongodb"
// then on every model change `@id @default(cuid())` to:
//   @id @default(auto()) @map("_id") @db.ObjectId
// and any FK string field (userId, assignedToId, createdById) to:
//   String @db.ObjectId
// Drop the `@db.Text` annotations on Account fields (Mongo strings have no
// length limit). Everything else carries over.
